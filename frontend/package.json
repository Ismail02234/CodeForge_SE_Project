{
    "name":  "codeforge-sveltekit",
    "private":  true,
    "version":  "3.0.0",
    "type":  "module",
    "scripts":  {
                    "dev":  "vite --host localhost",
                    "build":  "vite build",
                    "preview":  "vite preview --host localhost",
                    "check":  "svelte-kit sync \u0026\u0026 svelte-check --tsconfig ./tsconfig.json",
                    "test:contract":  "node tools/contract-test.mjs",
                    "format":  "prettier --write src",
                    "format:check":  "prettier --check src"
                },
    "devDependencies":  {
                            "@sveltejs/adapter-node":  "^5.0.0",
                            "@sveltejs/kit":  "^2.0.0",
                            "@sveltejs/vite-plugin-svelte":  "^5.0.0",
                            "prettier":  "^3.9.6",
                            "prettier-plugin-svelte":  "^4.1.1",
                            "svelte":  "^5.0.0",
                            "svelte-check":  "^4.0.0",
                            "typescript":  "^5.7.0",
                            "vite":  "^6.0.0"
                        }
}
